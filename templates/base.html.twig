<!DOCTYPE html>
<html lang="fr">
    <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}VaryaCode — Création de site internet en Dordogne{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}Création de site internet en Dordogne. VaryaCode accompagne artisans, associations et indépendants avec des sites vitrines professionnels dès 49 €/mois.{% endblock %}">
    <link rel="canonical" href="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}">

    {# Open Graph #}
    <meta property="og:title" content="{% block og_title %}VaryaCode — Création de site internet en Dordogne{% endblock %}">
    <meta property="og:description" content="{% block og_description %}Développeuse web en Dordogne. Sites internet pour artisans, associations et indépendants dès 49 €/mois.{% endblock %}">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="fr_FR">
    <meta property="og:site_name" content="VaryaCode">
    <meta property="og:url" content="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}">

    {# Favicons #}
    <link rel="icon" type="image/x-icon" href="{{ asset('img/favicon.ico') }}">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('img/favicon-32x32.png') }}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('img/favicon-16x16.png') }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('img/apple-touch-icon.png') }}">
    <link rel="manifest" href="{{ asset('img/site.webmanifest') }}">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600&family=Sora:wght@500;600;700&display=swap" rel="stylesheet">
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}

    {# Schema.org — LocalBusiness #}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "VaryaCode",
        "description": "Création de sites internet pour artisans, associations et indépendants en Dordogne",
        "url": "https://varyacode.fr",
        "email": "contact@varyacode.fr",
        "address": {
            "@type": "PostalAddress",
            "addressLocality": "Saint-Astier",
            "addressRegion": "Dordogne",
            "postalCode": "24110",
            "addressCountry": "FR"
        },
        "areaServed": [
            { "@type": "AdministrativeArea", "name": "Dordogne" },
            { "@type": "Country", "name": "France" }
        ],
        "priceRange": "49-119€/mois",
        "founder": {
            "@type": "Person",
            "name": "Sabrina Soulagnet"
        }
    }
    </script>
</head>
    <body class="bg-vc-bg text-vc-text font-body antialiased">
        {# Navbar #}
        {% include 'components/_navbar.html.twig' %}

        {# Main content #}
        <main>
            {% block body %}{% endblock %}
        </main>

        {# Footer #}
        {% include 'components/_footer.html.twig' %}
    </body>
</html>
